[Unit]
Description=CodeLogic IUP — Respaldo de la base de datos
After=mariadb.service
Requires=mariadb.service

[Service]
Type=oneshot
User=codelogic
Group=codelogic
ExecStart=/opt/codelogic/backup.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/codelogic/backups
