# ════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE CODELOGIC
# Copia este archivo como .env y completa los valores. El .env nunca va al
# repositorio y en el servidor debe tener permisos 600.
# ════════════════════════════════════════════════════════════════════

# Clave de las sesiones de Flask. Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-segura

# Base de datos: mysql (MariaDB, producción) | sqlite (desarrollo; crea instance/codelogic.db)
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=pseudocode_user
DB_PASSWORD=
DB_NAME=pseudocode_platform

# Servidor de desarrollo (en producción lo sirve Gunicorn, ver despliegue/)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
# Cookie de sesión solo por HTTPS. En desarrollo local sin HTTPS: false.
SESSION_COOKIE_SECURE=true
# Minutos sin actividad tras los que se cierra la sesión
SESION_INACTIVIDAD_MIN=30

# Cuenta docente que se crea en el primer arranque. Sin ADMIN_PASSWORD, la
# aplicación genera una clave y la muestra UNA vez.
ADMIN_EMAIL=docente@iup.edu.co
ADMIN_PASSWORD=
# Clave que devuelve el docente con «Reset clave» (obliga a cambiarla al entrar)
CLAVE_PROVISIONAL=

# Registro de cuentas: código opcional y dominio de correo exigido
REGISTRATION_CODE=
ALLOWED_EMAIL_DOMAIN=itp.edu.co

# Correo saliente (verificación y recuperación de la clave). Sin estos datos
# no se envían correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=CodeLogic IUP
PUBLIC_BASE_URL=
VERIFICATION_TTL_HOURS=48

# Inteligencia artificial: Google Gemini (https://aistudio.google.com/apikey).
# Sin clave, las funciones de IA avisan que no están disponibles.
GEMINI_API_KEY=

# Límites de uso
RATELIMIT_AI=20 per hour;120 per day
RATELIMIT_IA_TOTAL=150 per hour
FEEDBACK_MAX_POR_EJERCICIO=3
RATELIMIT_EXEC=60 per hour
RATELIMIT_AUTH=10 per 15 minutes
RATELIMIT_STORAGE_URI=memory://

# Ejecución sin entorno aislado cuando no hay bubblewrap (SOLO desarrollo
# local; nunca con la plataforma publicada en internet)
EXECUTOR_ALLOW_UNSAFE=false

# Tasa de cambio orientativa para mostrar los costos de IA en pesos
CODELOGIC_TRM_COP=4100

# Proveedor de respaldo OpenCode: apagado en el código
# (USAR_RESPALDO_OPENCODE = False en gemini_service.py)
OPENCODE_API_KEY=
