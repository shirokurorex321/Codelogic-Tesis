# ============================================
# CONFIGURACIÓN DE LA PLATAFORMA
# Copia este archivo como .env y completa los valores
# ============================================

# Clave secreta para sesiones de Flask (genera una con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia-esto-por-una-clave-segura

# Motor de base de datos: mysql (producción Linux) | sqlite (desarrollo Windows)
# Con sqlite no se necesita servidor de BD: se crea instance/codelogic.db
DB_ENGINE=mysql

# Base de datos MySQL/MariaDB (solo si DB_ENGINE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=pseudocode_user
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=pseudocode_platform

# Ejecución de código sin sandbox cuando no hay bubblewrap (SOLO desarrollo
# local en Windows; nunca con la app expuesta a internet por túnel)
EXECUTOR_ALLOW_UNSAFE=false

# OpenCode Zen — proveedor de IA primario (https://opencode.ai/zen)
OPENCODE_API_KEY=tu_api_key_de_opencode
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=deepseek-v4-flash-free
OPENCODE_MODEL_CONVERT=minimax-m2.5-free
OPENCODE_MODEL_TUTOR=deepseek-v4-flash-free

# Google Gemini API Key — fallback (obtén una gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Configuración del servidor
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True
